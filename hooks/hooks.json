{
  "description": "Ouroboros hooks: SessionStart injects the learning protocol; the others record session activity for reviews and the dashboard. None of them blocks anything.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "--no-warnings",
              "${CLAUDE_PLUGIN_ROOT}/scripts/hook.mjs",
              "SessionStart"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "--no-warnings",
              "${CLAUDE_PLUGIN_ROOT}/scripts/hook.mjs",
              "UserPromptSubmit"
            ],
            "async": true
          }
        ]
      }
    ],
    "UserPromptExpansion": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "--no-warnings",
              "${CLAUDE_PLUGIN_ROOT}/scripts/hook.mjs",
              "UserPromptExpansion"
            ],
            "async": true
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "--no-warnings",
              "${CLAUDE_PLUGIN_ROOT}/scripts/hook.mjs",
              "PostToolUse"
            ],
            "async": true
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "--no-warnings",
              "${CLAUDE_PLUGIN_ROOT}/scripts/hook.mjs",
              "PostToolUseFailure"
            ],
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "--no-warnings",
              "${CLAUDE_PLUGIN_ROOT}/scripts/hook.mjs",
              "Stop"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "--no-warnings",
              "${CLAUDE_PLUGIN_ROOT}/scripts/hook.mjs",
              "SessionEnd"
            ],
            "timeout": 5
          }
        ]
      }
    ]
  }
}
